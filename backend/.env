# Local TruthShield backend settings
BACKEND_SERVICE_NAME=TruthShield AI Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
BACKEND_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
BACKEND_GROQ_TIMEOUT_SECONDS=8
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
